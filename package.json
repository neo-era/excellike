{
  "name": "excellike",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs && node e2e/dot2.mjs && node e2e/dot3.mjs",
    "demo": "vite build --mode demo && node tools/artifact.mjs",
    "desktop": "npm run build && electron .",
    "e2e:desktop": "xvfb-run -a node e2e/desktop.mjs",
    "build:win": "npm run build && node tools/build-win.mjs"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "exceljs": "4.4.0",
    "hyperformula": "3.4.0",
    "jsdom": "26.1.0",
    "jszip": "3.10.1",
    "resedit": "^2.0.3",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "3.2.4"
  },
  "main": "electron/main.cjs",
  "description": "Bảng tính kiểu Excel 365 — bản Windows và PWA",
  "author": "Mai Vũ Lâm",
  "build": {
    "appId": "vn.lavipco.excellike",
    "productName": "ExcelLike",
    "copyright": "© 2026 Mai Vũ Lâm",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!dist/excellike-demo.html"
    ],
    "asar": true,
    "afterPack": "build/afterPack.cjs",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "build/lic/lic.exe",
        "to": "lic.exe"
      }
    ]
  },
  "dependencies": {
    "nspell": "^2.1.5"
  }
}
